using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Exercicio5
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int opcao;
            do
            {
                Console.Clear();
                Console.WriteLine("===== MENU =====");
                Console.WriteLine("1 – Soma");
                Console.WriteLine("2 – Subtração");
                Console.WriteLine("3 – Multiplicação");
                Console.WriteLine("4 – Divisão");
                Console.WriteLine("5 – Resto da Divisão");
                Console.WriteLine("6 – Potência");
                Console.WriteLine("7 – Raiz Cúbica");
                Console.WriteLine("8 – Cubo");
                Console.WriteLine("9 – Raiz Quadrada");
                Console.WriteLine("0 – Sair");
                Console.Write("Escolha uma opção: ");

                opcao = int.Parse(Console.ReadLine());

                if (opcao == 0)
                    break;

                double num1 = 0, num2 = 0;

                if (opcao >= 1 && opcao <= 6)
                {
                    Console.Write("Digite o primeiro número: ");
                    num1 = double.Parse(Console.ReadLine());
                    Console.Write("Digite o segundo número: ");
                    num2 = double.Parse(Console.ReadLine());
                }
                else if (opcao >= 7 && opcao <= 9)
                {
                    Console.Write("Digite o número: ");
                    num1 = double.Parse(Console.ReadLine());
                }

                switch (opcao)
                {
                    case 1:
                        Console.WriteLine($"Resultado: {Soma(num1, num2)}");
                        break;
                    case 2:
                        Console.WriteLine($"Resultado: {Subtracao(num1, num2)}");
                        break;
                    case 3:
                        Console.WriteLine($"Resultado: {Multiplicacao(num1, num2)}");
                        break;
                    case 4:
                        Console.WriteLine($"Resultado: {Divisao(num1, num2)}");
                        break;
                    case 5:
                        Console.WriteLine($"Resultado: {RestoDivisao(num1, num2)}");
                        break;
                    case 6:
                        Console.WriteLine($"Resultado: {Potencia(num1, num2)}");
                        break;
                    case 7:
                        Console.WriteLine($"Resultado: {RaizCubica(num1)}");
                        break;
                    case 8:
                        Console.WriteLine($"Resultado: {Cubo(num1)}");
                        break;
                    case 9:
                        Console.WriteLine($"Resultado: {RaizQuadrada(num1)}");
                        break;
                    default:
                        Console.WriteLine("Opção inválida!");
                        break;
                }

                Console.WriteLine("\nPressione qualquer tecla para continuar...");
                Console.ReadKey();

            } while (opcao != 0);
        }

        private static double Soma(double a, double b) => a + b;
        private static double Subtracao(double a, double b) => a - b;
        private static double Multiplicacao(double a, double b) => a * b;
        private static double Divisao(double a, double b) => b != 0 ? a / b : double.NaN;
        private static double RestoDivisao(double a, double b) => b != 0 ? a % b : double.NaN;
        private static double Potencia(double a, double b) => Math.Pow(a, b);
        private static double RaizCubica(double a) => Math.Pow(a, 1.0 / 3.0);
        private static double Cubo(double a) => Math.Pow(a, 3);
        private static double RaizQuadrada(double a) => Math.Sqrt(a);
    }
}
        
    

