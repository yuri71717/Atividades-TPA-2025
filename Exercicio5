using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Exercicio6
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Digite o valor de X: ");
            double x = double.Parse(Console.ReadLine());

            Console.Write("Digite o valor de Y: ");
            double y = double.Parse(Console.ReadLine());

            int quadrante = VerificaQuadrante(x, y);

            if (quadrante == 0)
                Console.WriteLine("O ponto está sobre um dos eixos ou na origem.");
            else
                Console.WriteLine($"O ponto ({x}, {y}) está no {quadrante}º quadrante.");

            Console.ReadKey();
        }

        private static int VerificaQuadrante(double x, double y)
        {
            if (x > 0 && y > 0)
                return 1; 
            else if (x < 0 && y > 0)
                return 2; 
            else if (x < 0 && y < 0)
                return 3;
            else if (x > 0 && y < 0)
                return 4; 
            else
                return 0; 
        }
    }
}
        
    

